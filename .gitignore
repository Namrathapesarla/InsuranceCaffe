# Dependencies
node_modules/
**/node_modules/

# Build / cache
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
**/.cache/
.vite/

# Environment & secrets (keep .env.example tracked)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test / coverage
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editor (optional: allow shared recommendations)
.vscode/*
!.vscode/extensions.json
.idea/

# Keys & certs (if ever added locally)
*.pem
*.key
