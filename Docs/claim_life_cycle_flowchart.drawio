        </mxCell>
        <mxCell id="start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dfe6e9;strokeColor=#636e72;fontColor=#2d3436;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="450" y="80" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fnol" value="&lt;b&gt;3.1 First Notice of Loss (FNOL)&lt;/b&gt;&lt;br&gt;Claimant reports incident via phone,&lt;br&gt;web, mobile app, or agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e3a5f;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="375" y="170" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="coverage" value="&lt;b&gt;3.2 Coverage Verification&lt;/b&gt;&lt;br&gt;Verify policy status, coverage type,&lt;br&gt;deductibles &amp; limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e3a5f;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="375" y="280" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="coverageCheck" value="Coverage&lt;br&gt;Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#fbbf24;fontColor=#78350f;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="420" y="390" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="deny" value="&lt;b&gt;Deny Claim&lt;/b&gt;&lt;br&gt;Notify claimant&lt;br&gt;with reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#fca5a5;fontColor=#7f1d1d;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="720" y="400" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="assignment" value="&lt;b&gt;3.3 Claim Assignment&lt;/b&gt;&lt;br&gt;Assign adjuster based on claim type,&lt;br&gt;complexity &amp; workload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e3a5f;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="375" y="510" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="investigation" value="&lt;b&gt;3.4 Investigation &amp; Assessment&lt;/b&gt;&lt;br&gt;Gather evidence, inspect damage,&lt;br&gt;interview witnesses, review docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e3a5f;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="375" y="620" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fraudCheck" value="Fraud&lt;br&gt;Suspected?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#fbbf24;fontColor=#78350f;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="420" y="730" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="siu" value="&lt;b&gt;SIU Referral&lt;/b&gt;&lt;br&gt;Special Investigations&lt;br&gt;Unit Review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#fca5a5;fontColor=#7f1d1d;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="720" y="740" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reserve" value="&lt;b&gt;3.5 Reserve Management&lt;/b&gt;&lt;br&gt;Set initial reserves, adjust as&lt;br&gt;new information emerges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e3a5f;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="375" y="850" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;3.6 Claim Decision&lt;/b&gt;&lt;br&gt;Evaluate liability, approve or&lt;br&gt;deny based on findings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e3a5f;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="375" y="960" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="approvalCheck" value="Claim&lt;br&gt;Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#fbbf24;fontColor=#78350f;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="420" y="1070" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dispute" value="&lt;b&gt;Dispute / Appeal&lt;/b&gt;&lt;br&gt;Claimant notified,&lt;br&gt;appeal process offered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#fca5a5;fontColor=#7f1d1d;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="720" y="1080" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="settlement" value="&lt;b&gt;3.7 Settlement &amp; Payments&lt;/b&gt;&lt;br&gt;Calculate payout, issue payment&lt;br&gt;to claimant or repair vendor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e3a5f;fontSize=12;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="375" y="1190" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="closure" value="&lt;b&gt;3.8 Claim Closure&lt;/b&gt;&lt;br&gt;Document findings, close file,&lt;br&gt;update records &amp; analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#93c5fd;fontColor=#1e3a5f;fontSize=12;arcSize=10;" parent="1" vertex="1">
