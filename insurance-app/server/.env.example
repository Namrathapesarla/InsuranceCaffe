# PostgreSQL (Nest API — pg-pool.service.ts)
# Two pools: X-Schema `local` → DB_* (Kimball reporting). X-Schema `india`/`us` → REMOTE_DB_* when set.
# USE_LOCAL_DB=1: only DB_* pool; india/us hit local DB with INDIA_DB_SCHEMA/US_DB_SCHEMA names.
# REMOTE_DB_SSL=false if the host does not use TLS.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_SCHEMA=reporting
DB_USER=postgres
DB_PASSWORD=your_password

# Schema names must match PostgreSQL exactly (run: SELECT schema_name FROM information_schema.schemata;).
# UI "India" / "United States" only picks X-Schema keys; these env vars choose the real schema on the server.
# DigitalOcean Insurance_CaffeV1 example (names must match information_schema.schemata):
# INDIA_DB_SCHEMA=Reporting_IND
# US_DB_SCHEMA=Reporting_US
# Local-only example: INDIA_DB_SCHEMA=Reporting_layer_India, US_DB_SCHEMA=reporting

# Optional: comma-separated schema names that use enterprise SQL (*_sk, FPT columns). INDIA_DB_SCHEMA / US_DB_SCHEMA also enable enterprise mode when matched.
# ENTERPRISE_DB_SCHEMAS=Reporting_IND,Reporting_US

# Remote (e.g. DigitalOcean). When REMOTE_DB_HOST is non-empty, these replace DB_* for the pool.
REMOTE_DB_HOST=
REMOTE_DB_PORT=25060
REMOTE_DB_NAME=
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
# REMOTE_DB_SSL=false  # only if your provider does not need TLS
# USE_LOCAL_DB=1       # force localhost DB_* when REMOTE_* is also set

PORT=3001
